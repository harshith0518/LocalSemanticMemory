# Local development only. Set these before first startup; never commit .env.
# Changing these later does not rotate passwords stored in an existing volume.
JARVIS_POSTGRES_PASSWORD=local-only-admin-change-me
JARVIS_MIGRATION_PASSWORD=local-only-migration-change-me
JARVIS_APP_PASSWORD=local-only-runtime-change-me
JARVIS_API_PORT=8000
