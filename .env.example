# Local development only. Set these before first startup; never commit .env.
# Changing these later does not rotate passwords stored in an existing volume.
JARVIS_POSTGRES_PASSWORD=local-only-admin-change-me
JARVIS_MIGRATION_PASSWORD=local-only-migration-change-me
JARVIS_APP_PASSWORD=local-only-runtime-change-me
JARVIS_API_PORT=8000
# Enable only after the explicit synthetic-only NVIDIA trial decision.
# Combined lifetime limits: 1100 requests, 10,000,000 accounted tokens, $0 paid.
# Exact checked-in synthetic sources/questions only unless unfamiliar opt-in below is enabled.
JARVIS_S07_SYNTHETIC_TRIAL_APPROVED=false
NEMOTRON_30B_API_KEY=
KIMI_K3_API_KEY=
JARVIS_RESPONSE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
JARVIS_MAX_REQUESTS=1100
JARVIS_MAX_TOTAL_TOKENS=10000000
# Separate operator consent for an unfamiliar Normal-mode corpus and new questions.
# NVIDIA may retain/use submitted content under its data terms. Do not use sensitive data
# without the necessary permission. Private remains blocked. Never commit the filled file.
JARVIS_UNFAMILIAR_INFERENCE_APPROVED=false
# To opt in, set the preceding flag to true AND the following exact acknowledgement:
# JARVIS_UNFAMILIAR_DATA_POLICY_ACK=I_ACCEPT_NVIDIA_DATA_TERMS
JARVIS_UNFAMILIAR_DATA_POLICY_ACK=
NVIDIA_API_KEY=
# Google is the primary demo route. Google free inputs/outputs may be used for improvement and
# human review, so keep it to non-sensitive demo data. No provider is chosen automatically.
JARVIS_INFERENCE_PROVIDER=google
JARVIS_FREE_SYNTHETIC_TRIAL_APPROVED=false
# Independent demo opt-ins. All default off. Enable only for non-sensitive demo data.
# Sources allows locally entered synthetic notes. Private sends only its current question
# to the provider, with no database context, source write, memory write, or saved transcript.
JARVIS_FREE_SYNTHETIC_QUESTIONS_APPROVED=false
JARVIS_FREE_SYNTHETIC_SOURCES_APPROVED=false
JARVIS_PRIVATE_DIRECT_APPROVED=false
JARVIS_FREE_DATA_POLICY_ACK=
# After informed synthetic-only approval:
# JARVIS_FREE_DATA_POLICY_ACK=I_ACCEPT_FREE_SYNTHETIC_DATA_TERMS
GOOGLE_API_KEY_FREE_TIER=
OPEN_ROUTER_API_KEY=

# Optional local backup. Set the provider to ollama only when you deliberately want the local
# Qwen route, then start `ollama serve` on the host before Docker Compose. The API container uses
# host.docker.internal (mapped to host-gateway on Linux Docker); it cannot be pointed at a cloud
# URL. `ollama` is the ignored dummy value required by OpenAI-compatible clients, not a secret.
# The chat model is used for both extraction and answers. Private direct chat remains a separate,
# context-free opt-in. No vector retrieval or embedding call is enabled yet.
JARVIS_OLLAMA_ENABLED=false
JARVIS_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
JARVIS_OLLAMA_API_KEY=ollama
JARVIS_OLLAMA_EXTRACTOR_MODEL=qwen3:4b
JARVIS_OLLAMA_RESPONDER_MODEL=qwen3:4b
JARVIS_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
JARVIS_OLLAMA_PRIVATE_DIRECT=false

# Manual NVIDIA reasoning backup; never used automatically.
POOLSIDE_LAGUNA_XS_2P1=
# Optional embedding diagnostic key. Dense retrieval/tool execution are not enabled.
NEMOTRON_1B_EMBED=
# Optional free-route role models. Google uses the tested Flash-Lite model by default.
JARVIS_FREE_EXTRACTOR_MODEL=gemini-3.5-flash-lite
JARVIS_FREE_RESPONDER_MODEL=gemini-3.5-flash-lite
